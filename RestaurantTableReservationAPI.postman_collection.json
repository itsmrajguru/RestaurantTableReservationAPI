		{
			"name": "Happy Path Business Scenarios",
			"item": [
				{
					"name": "Scenario 1: Admin Configures Tables",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"tableNumber\": \"T-{{$randomInt}}\",\n    \"capacity\": 4,\n    \"description\": \"Test table added via Postman runner\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tables",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tables"
							]
						}
					}
				},
				{
					"name": "Scenario 2: Customer Books a Table",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"reservationId\", jsonData.id);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var offset = Math.floor(Math.random() * 20) + 11;",
									"var date = new Date();",
									"date.setDate(date.getDate() + offset);",
									"var yyyy = date.getFullYear();",
									"var mm = String(date.getMonth() + 1).padStart(2, '0');",
									"var dd = String(date.getDate()).padStart(2, '0');",
									"var dateStr = yyyy + '-' + mm + '-' + dd;",
									"pm.environment.set('dynamicDate', dateStr);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{customerToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reservationDate\": \"{{dynamicDate}}\",\n    \"timeSlotId\": 1,\n    \"partySize\": 6,\n    \"notes\": \"Window seat preferred please!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/reservations",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"reservations"
							]
						}
					}
				},
